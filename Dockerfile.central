# One instance with a persistent Railway volume at /data.
FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod *.go ./
COPY public ./public
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/ddd .

FROM alpine:3.22
RUN apk add --no-cache su-exec && adduser -D -u 10001 ddd && mkdir -p /data
COPY --from=build /out/ddd /usr/local/bin/ddd
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint
ENV PORT=8080
EXPOSE 8080
VOLUME /data
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]
